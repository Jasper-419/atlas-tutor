# Copy to .env. Never commit credentials.
APP_NAME=Atlas

# OpenAI-compatible chat API (DeepSeek also supported).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Leave URL/model blank for provider defaults: OpenAI gpt-4o-mini,
# or DeepSeek deepseek-flash when only DEEPSEEK_API_KEY is configured.
# Alternative: leave OPENAI_API_KEY empty and set DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=

# Users can add their own model APIs in Settings → AI connections.
# Encryption key: leave blank to generate data/.credentials.key (back it up with the DB).
# Multi-host deployments must share this key; API and worker must use the same value.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATLAS_CREDENTIALS_KEY=

# Optional semantic retrieval. Without an embedding model, keyword retrieval works.
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Optional web search. Without this, research can safely fetch public document URLs.
TAVILY_API_KEY=

# Local: leave DATABASE_URL unset to use data/atlas.db.
# DATABASE_URL=postgresql+psycopg://atlas:your-password@localhost:5432/atlas
# CHECKPOINT_DATABASE_URL=postgresql://atlas:your-password@localhost:5432/atlas
WORKER_MODE=embedded
REDIS_URL=redis://localhost:6379/0
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=12

# Optional server-owned Agent limits, frozen when a turn is admitted.
# Tutor defaults: 6 rounds / 12 tool calls; Solve: 14 / 20.
# Explicit overrides below apply to every capability.
# ATLAS_AGENT_MAX_ROUNDS=6
# ATLAS_AGENT_MAX_TOOL_CALLS=12
# ATLAS_AGENT_MAX_MODEL_RETRIES=1
# ATLAS_AGENT_MAX_READ_RETRIES=1
# ATLAS_AGENT_MAX_TOOL_RECOVERIES=1
# ATLAS_AGENT_TIMEOUT_SECONDS=480

# Docker database (change this before deploying outside your own machine).
POSTGRES_PASSWORD=atlas-local-change-me
